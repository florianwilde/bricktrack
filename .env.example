# ---------------------------------------------------------------------------
# Bricktrack - Beispielkonfiguration
# Kopiere diese Datei nach .env und passe die Werte an.
# ---------------------------------------------------------------------------

# Oeffentliche Adresse der App, so wie sie im Browser erscheint.
# Wichtig: Passkeys sind an diese Domain gebunden (WebAuthn RP-ID). Wird die
# Domain spaeter geaendert, muessen alle Passkeys neu angelegt werden.
BASE_URL=https://bricktrack.example.de

# Signiergeheimnis fuer Sessions und Tokens - mindestens 32 Zeichen.
# Erzeugen mit:  openssl rand -base64 48
BETTER_AUTH_SECRET=bitte-aendern-mindestens-32-zeichen-lang-000000

# Verzeichnis fuer Datenbank und Uploads. Im Container immer /data.
DATA_DIR=/data

# Maximale Groesse je Upload in Megabyte (Anleitungs-PDFs koennen gross sein).
MAX_UPLOAD_MB=25

# Zeitzone des Containers.
TZ=Europe/Berlin

# Wo der Container auf dem Host lauscht. Voreinstellung: nur localhost, weil
# der Reverse Proxy auf demselben Host laeuft. Sitzt der Proxy woanders:
# BIND_ADDRESS=0.0.0.0 (und dann unbedingt die Firewall zuziehen).
# BIND_ADDRESS=127.0.0.1
# HOST_PORT=3000

# Optional: Rebrickable-API-Key fuer den Lego-Import. Damit reicht auf der
# Seite "Neues Set" die Setnummer, und Name, Jahr, Teile, Minifiguren, Thema
# und Bild werden uebernommen. Ohne Key funktioniert alles manuell weiter.
# Kostenlos anlegen: https://rebrickable.com/api/ (Konto -> Settings -> API)
# REBRICKABLE_API_KEY=

# Optional: Mailversand fuer Erinnerungen an Wunschlisten-Termine. Einfacher
# geht es in der App unter Mehr -> Erinnerungen -> Mailserver. Steht der
# Server hier, hat die .env Vorrang und die App zeigt ihn nur an.
# SMTP_HOST=mail.example.de
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=bricktrack@example.de
# SMTP_PASSWORD=
# SMTP_FROM=Bricktrack <bricktrack@example.de>

# Wie viele Tage vor dem Termin erinnert wird (Standard: 14).
# REMINDER_DAYS_BEFORE=14
